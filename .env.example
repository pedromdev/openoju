# =============================================================================
# OpenOju — variáveis de ambiente
# Copie para .env e ajuste. Nunca versione valores reais.
# =============================================================================

# Banco de dados
OJU_DATABASE_URL=postgresql+psycopg://openoju:change-me@localhost:5432/openoju

# Sessão e segurança
OJU_SESSION_COOKIE=openoju_session
OJU_SESSION_TTL_HOURS=720
OJU_COOKIE_SECURE=true
OJU_CSRF_ENABLED=true
# Token de uso único que autoriza o setup inicial.
OJU_SETUP_TOKEN=change-me
OJU_SECRET_KEY=change-me-32-bytes-minimum
# Chave Fernet (base64) para segredos em repouso: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OJU_FERNET_KEY=change-me

# URL pública
OJU_PUBLIC_BASE_URL=https://openoju.example.com
OJU_CORS_ORIGINS=https://openoju.example.com,http://localhost:4200,http://127.0.0.1:4200

# Caminhos locais (o Docker Compose sobrescreve para /app/data)
OJU_DATA_DIR=./data
OJU_MEDIA_ROOT=/srv/openoju
# Organização do watcher de pasta (vazio = watcher desabilitado)
OJU_WATCH_ORG_SLUG=
OJU_WATCH_DIR=/srv/openoju/inbox

# Docker Compose: caminhos no host e nomes das redes externas
OJU_MEDIA_HOST_DIR=/srv/openoju
OJU_IMPORT_HOST_DIR=/srv/openoju/import
OJU_PROXY_NETWORK=proxy

# Análise
OJU_SAMPLE_FPS=1.0
OJU_ANALYSIS_WIDTH=640
OJU_ENABLE_VAAPI=true
OJU_VAAPI_DEVICE=/dev/dri/renderD128

# Storage: local (dev/offline) ou s3 (MinIO/S3)
OJU_STORAGE_BACKEND=local
OJU_S3_ENDPOINT=https://s3.openoju.example.com
OJU_S3_INTERNAL_ENDPOINT=http://minio:9000
OJU_S3_BUCKET=openoju
OJU_S3_ACCESS_KEY=
OJU_S3_SECRET_KEY=
OJU_S3_REGION=us-east-1
OJU_S3_PART_SIZE=16777216
# Deixe false quando o bucket é criado por IaC (RDS/S3 gerenciados sem CreateBucket)
OJU_S3_CREATE_BUCKET=true

# OIDC
OJU_OIDC_ENABLED=false
OJU_OIDC_ISSUER=
OJU_OIDC_CLIENT_ID=
OJU_OIDC_CLIENT_SECRET=
OJU_OIDC_REDIRECT_URI=https://openoju.example.com/api/v1/auth/oidc/callback

# Retenção
OJU_RETENTION_MEDIA_DAYS=30
OJU_RETENTION_ACCESS_LOG_MONTHS=6
OJU_RETENTION_AUDIT_MONTHS=12

# URL do frontend (para redirects de OIDC/convite). Vazio = OJU_PUBLIC_BASE_URL
OJU_FRONTEND_BASE_URL=

# OIDC (Fase 4)
OJU_OIDC_SCOPES=openid email profile
OJU_OIDC_AUTO_PROVISION=false
OJU_OIDC_DEFAULT_GROUP=Viewer

# Login rate limit
OJU_RATE_LIMIT_BACKEND=memory
OJU_LOGIN_RATE_LIMIT_ATTEMPTS=10
OJU_LOGIN_RATE_LIMIT_WINDOW_S=300

# Webhooks (Fase 6)
OJU_WEBHOOK_TIMEOUT_S=10
OJU_WEBHOOK_MAX_ATTEMPTS=6
OJU_WEBHOOK_ALLOW_HTTP=false
OJU_DISPATCHER_INTERVAL_S=10
OJU_DISPATCHER_BATCH_SIZE=50

# Retenção (Fase 7)
OJU_MAINTENANCE_INTERVAL_S=3600
OJU_RETENTION_WEBHOOK_DAYS=30
OJU_RETENTION_SESSION_DAYS=30
